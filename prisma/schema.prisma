// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum BookStatus {
  TO_READ
  READING
  FINISHED
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  name               String
  isAdmin            Boolean   @default(false)
  approved           Boolean   @default(false)
  xp                 Int       @default(0)
  showOnLeaderboard  Boolean   @default(true)
  currentStreak      Int       @default(0)
  longestStreak      Int       @default(0)
  lastActiveDate     DateTime?
  streakShieldCount  Int       @default(0)
  createdAt          DateTime  @default(now())

  books        Book[]
  persons      Person[]
  goal         Goal?
  achievements UserAchievement[]
  dailyActivities DailyActivity[]
  streakShields   StreakShield[]
  settings        UserSettings?
}

model Book {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Core (existing)
  isbn           String?
  title          String
  author         String?
  coverUrl       String?
  coverFetchedAt DateTime?
  status         BookStatus @default(TO_READ)
  addedAt        DateTime   @default(now())
  finishedAt     DateTime?

  // Legacy parity — 17 fields
  subtitle       String?
  publishers     String?
  publishDate    String?
  publishPlaces  String?
  editionName    String?
  series         String?
  numberOfPages  String?
  languages      String?
  isbn10         String?
  isbn13         String?
  subjects       String?
  rating         Int        @default(0)
  notes          String?
  tags           String?    // csv lowercased
  startedAt      DateTime?
  signed         Boolean    @default(false)
  copies         Int        @default(1)
  currentPage    Int?

  lendingRecords LendingRecord[]

  @@index([userId])
  @@index([tags])
}

model Person {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  loans LendingRecord[]

  @@unique([userId, name])
  @@index([userId])
}

model LendingRecord {
  id           String    @id @default(cuid())
  bookId       String
  book         Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  // Denormalized snapshot — survives book delete via Loan logic (legacy)
  bookTitle    String?
  borrowerName String
  // Optional person link (new)
  personId     String?
  person       Person?   @relation(fields: [personId], references: [id], onDelete: SetNull)
  personName   String?
  lentAt       DateTime  @default(now())
  returnedAt   DateTime?
  dueDate      DateTime?

  @@index([bookId])
  @@index([personId])
}

model Goal {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  yearly    Int      @default(0)
  monthly   Int      @default(0)
  updatedAt DateTime @updatedAt
}

// Static catalog of achievements; titleKey/descriptionKey reference i18n message keys.
model Achievement {
  id             String @id @default(cuid())
  key            String @unique
  titleKey       String
  descriptionKey String
  iconKey        String

  unlockedBy UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime    @default(now())

  @@unique([userId, achievementId])
}

model DailyActivity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  count     Int      @default(1)
  pagesRead Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

model StreakShield {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  usedAt    DateTime @default(now())

  @@index([userId])
}

model UserSettings {
  id                    String  @id @default(cuid())
  userId                String  @unique
  user                  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationsEnabled  Boolean @default(true)
  streakReminders       Boolean @default(true)
  weeklyDigest          Boolean @default(false)

  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@unique([userId, endpoint])
  @@index([userId])
}
