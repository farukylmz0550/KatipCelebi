# Copy to .env for local dev, or to .env for docker-compose (it reads the same file via `env_file`-less var substitution).
NEXTAUTH_SECRET=change-me-to-a-long-random-string
NEXTAUTH_URL=http://localhost:3000
APP_PORT=3000
# Set to "false" to disable public registration (default: true)
ALLOW_REGISTRATION=true
# Required for /api/test/reset — generate with: openssl rand -base64 32
RESET_SECRET=

# Local dev (SQLite file):
DATABASE_URL="file:./prisma/dev.db"
