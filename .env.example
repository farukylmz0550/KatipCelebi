# Copy to .env for local dev, or to .env for docker-compose (it reads the same file via `env_file`-less var substitution).
POSTGRES_PASSWORD=change-me
NEXTAUTH_SECRET=change-me-to-a-long-random-string
NEXTAUTH_URL=http://localhost:3000
APP_PORT=3000

# Local dev only (docker-compose sets DATABASE_URL itself):
DATABASE_URL=postgres://katipcelebi:change-me@localhost:5432/katipcelebi
